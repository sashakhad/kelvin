# PostgreSQL connection string used by Prisma.
# Local Docker (`pnpm db:up`):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kelvin?schema=public"

# Or paste a hosted URL (Neon, Vercel Postgres, Supabase, etc.):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Bearer token for GET /api/admin/preorders (CSV export). Use a long random string.
ADMIN_TOKEN="replace-with-a-long-random-string"

# Salt for hashing pre-order IP addresses. Never commit a real salt.
# A missing salt refuses to store submissions.
IP_HASH_SALT="replace-with-a-different-long-random-string"
